{
    "functions": [
        {
            "name": "input-group",
            "description": "Create an input map group.",
            "examples": ["(input-group\n\t(input:\n\t\t(input-keyboard (keycode: :left))\n\t\t(input-keyboard (keycode: :right))\n\t)\n)"],
            "return": { "type": "custom:input-map" },
            "options": [
                {
                    "name": "input",
                    "description": "The inputs to be grouped together.",
                    "args": [
                        [{ "type": "list", "name": "inputs", "value": [{ "type": "custom:input-map", "name": "input" }] }],
                        { "repeat": [{ "type": "custom:input-map", "name": "input" }] }
                    ]
                },
                {
                    "name": "all-active",
                    "description": "Whether all the grouped inputs need to be active.",
                    "args": [[{ "type": "boolean" }]]
                }
            ]
        },
